# Vulkan: only the headers are needed on macOS — VulkanLoader.h includes
# ext/vulkan/vulkan.h unconditionally (NO_VULKAN disables actually *using*
# the API, not the type declarations the loader header needs to compile).
# The compiled binaries (MoltenVK .dylib, Linux libvulkan.so*) are never
# referenced by PPSSPP.xcodeproj and are not vendored.
PPSSPP-Core/ppsspp/ext/vulkan/macOS/
PPSSPP-Core/ppsspp/ext/vulkan/iOS/
PPSSPP-Core/ppsspp/ext/vulkan/*.so
PPSSPP-Core/ppsspp/ext/vulkan/*.so.*

# OpenXR: only the headers are needed on macOS, same story as Vulkan
# above — Common/VR/*.cpp includes <openxr.h> unconditionally. The
# compiled binaries (Pico/Quest Android VR headset loader .so files)
# are never referenced by PPSSPP.xcodeproj and are not vendored.
PPSSPP-Core/ppsspp/ext/openxr/libs/

# Android assets / platform-specific directories not needed for macOS build
PPSSPP-Core/ppsspp/android/
PPSSPP-Core/ppsspp/UWP/
PPSSPP-Core/ppsspp/Windows/
PPSSPP-Core/ppsspp/Qt/
PPSSPP-Core/ppsspp/libretro/
PPSSPP-Core/ppsspp/dx9sdk/

# pspautotests — test ROMs, not needed for build
PPSSPP-Core/ppsspp/pspautotests/

# Git metadata from flattened submodules
PPSSPP-Core/ppsspp/ext/armips/.git
PPSSPP-Core/ppsspp/ext/glslang/.git
PPSSPP-Core/ppsspp/ext/SPIRV-Cross/.git
PPSSPP-Core/ppsspp/ext/zstd/.git
PPSSPP-Core/ppsspp/ext/rapidjson/.git
PPSSPP-Core/ppsspp/ext/miniupnp/.git
PPSSPP-Core/ppsspp/ext/armips/ext/filesystem/.git
